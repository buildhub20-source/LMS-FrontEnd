# Copy to .env.local and fill in. Never commit real secrets.
# Every VITE_ variable is inlined into the client bundle and is PUBLIC.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws
VITE_APP_NAME=GradusMind
VITE_APP_ENV=development
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=
VITE_CHAT_SERVICE_URL=http://localhost:3001/api/v1/chat
VITE_CHAT_WS_URL=http://localhost:3001
VITE_NOTIFICATION_SERVICE_URL=http://localhost:3002/api/v1/notifications
VITE_NOTIFICATION_WS_URL=http://localhost:3002
# Workspaces are <slug>.<base domain>. Leave empty locally to use <slug>.localhost.
VITE_TENANT_BASE_DOMAIN=
# Optional: proxies /api through the dev server to avoid CORS in development.
VITE_DEV_PROXY_TARGET=
